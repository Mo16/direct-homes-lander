# Waitlist: the app's Supabase project (same values as webapp/.env.local). Server only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend: welcome email + the "DirectHomes waitlist" segment. Server only.
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=
WAITLIST_FROM=
# Signs the leave links in the welcome email. Keep it the same once emails have gone out.
WAITLIST_SECRET=
# Public address of this site, used in email links (https://direct-homes.co.uk in production).
SITE_URL=
